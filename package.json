    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^31.0.1",
    "vite": "^6.3.5",
    "vitest": "^5.1.1",
    "zod": "^4.6.7"
  }
}
